# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_url_shortener

# JWT
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ACCESS_TOKEN_EXP_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXP_HOURS=24

# App
APP_NAME=AI URL Shortner
DEBUG=true
PUBLIC_BASE_URL=https://urls.rf.gd

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail
MAIL_FROM=
MAIL_FROM_NAME=AI URL Shortner
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=20
